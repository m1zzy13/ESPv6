local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer
local TweenService = game:GetService("TweenService")

-- Settings
local espEnabled = true
local maxESPDistance = 1000
local suspicionThreshold = 3
local susReactionDelay = 2

-- Anti-ESP Detection Variables
local playerSuspicion = {}

local function rainbowColor(offset)
    local hue = (tick() * 0.25 + offset) % 1
    return Color3.fromHSV(hue, 1, 1)
end

local function getESPColor(player, distance)
    if distance > maxESPDistance then
        return Color3.fromRGB(100, 100, 100)
    end
    if player.Team == LocalPlayer.Team then
        return rainbowColor(0.3)
    else
        return rainbowColor(0)
    end
end

local function detectSuspiciousBehavior(player, rootPosition)
    local distance = (Camera.CFrame.Position - rootPosition).Magnitude
    local suspicionLevel = playerSuspicion[player.UserId] or 0

    local playerInFOV = Camera:WorldToViewportPoint(rootPosition)
    local isBehindWall = playerInFOV.X < 0 or playerInFOV.X > 1 or playerInFOV.Y < 0 or playerInFOV.Y > 1

    if isBehindWall then
        suspicionLevel = suspicionLevel + 1
    end

    if suspicionLevel > suspicionThreshold then
        local esp = player.Character:FindFirstChild("ESP")
        if esp then
            local highlight = esp:FindFirstChild("ESPHighlight")
            if highlight then
                highlight.FillColor = Color3.fromRGB(255, 0, 0)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 0)
                highlight.FillTransparency = 0.5
            end
        end
    end

    playerSuspicion[player.UserId] = suspicionLevel
end

local function resetSuspicion(player)
    wait(susReactionDelay)
    playerSuspicion[player.UserId] = 0
end

-- Setup ESP (without name and health UI)
local function applyESP(player)
    if player == LocalPlayer then return end

    local function setup()
        local character = player.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then return end
        if character:FindFirstChild("ESP") then return end

        local espFolder = Instance.new("Folder", character)
        espFolder.Name = "ESP"

        local highlight = Instance.new("Highlight")
        highlight.Name = "ESPHighlight"
        highlight.Adornee = character
        highlight.FillColor = Color3.new(1, 0, 0)
        highlight.OutlineColor = Color3.new(1, 0, 0)
        highlight.FillTransparency = 0.8
        highlight.OutlineTransparency = 0.1
        highlight.Enabled = espEnabled
        highlight.Parent = espFolder

        -- Removed BillboardGui (nametag and health bar)
        --[[
        local root = character:FindFirstChild("HumanoidRootPart")
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "ESPBillboard"
        billboard.Adornee = character:FindFirstChild("Head") or root
        billboard.Size = UDim2.new(0, 200, 0, 70)
        billboard.StudsOffset = Vector3.new(0, 3.5, 0)
        billboard.AlwaysOnTop = true
        billboard.MaxDistance = math.huge
        billboard.Parent = espFolder

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Name = "NameLabel"
        nameLabel.Parent = billboard
        nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
        nameLabel.Position = UDim2.new(0, 0, 0, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.TextColor3 = Color3.new(1, 0, 0)
        nameLabel.TextStrokeTransparency = 0
        nameLabel.Text = player.Name
        nameLabel.Font = Enum.Font.Legacy
        nameLabel.TextScaled = true

        local healthBack = Instance.new("Frame")
        healthBack.Name = "HealthBackground"
        healthBack.Parent = billboard
        healthBack.Size = UDim2.new(1, -10, 0.15, 0)
        healthBack.Position = UDim2.new(0, 5, 0.55, 0)
        healthBack.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        healthBack.BorderSizePixel = 0

        local healthBar = Instance.new("Frame")
        healthBar.Name = "HealthBar"
        healthBar.Parent = healthBack
        healthBar.Size = UDim2.new(1, 0, 1, 0)
        healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
        healthBar.BorderSizePixel = 0
        ]]
    end

    if player.Character then
        setup()
    end

    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        setup()
    end)
end

for _, player in ipairs(Players:GetPlayers()) do
    applyESP(player)
end
Players.PlayerAdded:Connect(applyESP)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.LeftAlt then
        espEnabled = not espEnabled
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local esp = player.Character:FindFirstChild("ESP")
                if esp then
                    local highlight = esp:FindFirstChild("ESPHighlight")
                    if highlight then highlight.Enabled = espEnabled end
                end
            end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if not espEnabled then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("ESP") then
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")

            if root and humanoid then
                detectSuspiciousBehavior(player, root.Position)

                if playerSuspicion[player.UserId] and playerSuspicion[player.UserId] > 0 then
                    resetSuspicion(player)
                end
            end
        end
    end
end)

